{
  "version": 2,
  "functions": {
    "api/index.py": {
      "includeFiles": "backend/**"
    },
    "backend/api/index.py": {
      "includeFiles": "backend/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/cleanup-photos",
      "schedule": "30 2 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py?path=$1"
    }
  ]
}
